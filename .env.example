# ก๊อปไฟล์นี้เป็น .env.local แล้วใส่ค่าจริง (ห้าม commit .env.local)
# บน Vercel ใส่ค่าเดียวกันที่ Settings → Environment Variables (ยกเว้น USE_MOCK)

# API key จาก https://console.anthropic.com
ANTHROPIC_API_KEY=

# ---- Login ด้วย Google (Auth.js) ----
# สุ่มด้วยคำสั่ง: npx auth secret  (ใช้คนละค่ากับบนเครื่องก็ได้)
AUTH_SECRET=
# จาก Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ---- ฐานข้อมูลประวัติ (Neon Postgres) ----
# Vercel → Storage → Neon ต่อเข้าโปรเจกต์แล้วจะได้ค่านี้ · ก๊อปมาใส่ หรือรัน vercel env pull .env.local
DATABASE_URL=

# ใส่ 1 = ใช้ข้อมูลปลอม ไม่เรียก Claude ไม่ต้อง login ไม่บันทึกประวัติ (ใช้ตอนแต่ง UI)
# USE_MOCK=1
